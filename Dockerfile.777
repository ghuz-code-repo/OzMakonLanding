# Супер-агрессивный Dockerfile с правами 777 на ВСЁ
FROM node:22

WORKDIR /app

# Копируем package.json и устанавливаем зависимости
COPY package*.json ./
RUN npm install

# СРАЗУ ПОСЛЕ УСТАНОВКИ - МАКСИМАЛЬНЫЕ ПРАВА
RUN chmod -R 777 /app
RUN find /app -type f -exec chmod 777 {} \;
RUN find /app -type d -exec chmod 777 {} \;

# Копируем весь проект
COPY . .

# ЕЩЁ РАЗ МАКСИМАЛЬНЫЕ ПРАВА НА ВСЁ
RUN chmod -R 777 /app
RUN find /app -type f -exec chmod 777 {} \;
RUN find /app -type d -exec chmod 777 {} \;

# Специально для node_modules
RUN chmod -R 777 node_modules/
RUN find node_modules/ -name "*.js" -exec chmod +x {} \;
RUN find node_modules/.bin/ -type f -exec chmod +x {} \;

# Собираем проект
RUN npx vite build

# Открываем порт 80
EXPOSE 80

# Запускаем сайт
CMD ["npx", "vite", "preview", "--host", "0.0.0.0", "--port", "80"]
