# Альтернативный способ - прямое использование node
FROM node:22

WORKDIR /app

# Копируем package.json и устанавливаем зависимости
COPY package*.json ./
RUN npm install

# Копируем весь проект
COPY . .

# Собираем проект через node напрямую
RUN node node_modules/vite/bin/vite.js build

# Открываем порт 80
EXPOSE 80

# Запускаем через node напрямую
CMD ["node", "node_modules/vite/bin/vite.js", "preview", "--host", "0.0.0.0", "--port", "80"]
