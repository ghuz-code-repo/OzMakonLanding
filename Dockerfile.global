# Самое простое решение - глобальная установка vite
FROM node:22

# Устанавливаем vite глобально
RUN npm install -g vite

WORKDIR /app

# Копируем package.json и устанавливаем зависимости
COPY package*.json ./
RUN npm install

# Копируем весь проект
COPY . .

# Собираем проект
RUN vite build

# Открываем порт 80
EXPOSE 80

# Запускаем сайт
CMD ["vite", "preview", "--host", "0.0.0.0", "--port", "80"]
