# Dockerfile с максимальными правами доступа
FROM node:22

WORKDIR /app

# Копируем package.json и устанавливаем зависимости
COPY package*.json ./
RUN npm install

# Копируем весь проект
COPY . .

# МАКСИМАЛЬНЫЕ ПРАВА НА ВСЁ!
RUN chmod -R 777 /app
RUN chmod -R 777 node_modules/
RUN chmod -R +x node_modules/.bin/
RUN chmod +x node_modules/.bin/*

# Отладка: проверяем что получилось
RUN echo "=== Testing permissions ===" && ls -la node_modules/.bin/ | head -5

# Собираем проект через npx
RUN npx vite build

# Открываем порт 80
EXPOSE 80

# Запускаем сайт на порту 80 через npx
CMD ["npx", "vite", "preview", "--host", "0.0.0.0", "--port", "80"]
